with Files("**"):
    BUG_COMPONENT = ("Core", "DOM: File")

EXPORTS.mozilla.dom += [
    "CrossOriginStorageChild.h",
    "CrossOriginStorageManager.h",
    "CrossOriginStorageParent.h",
    "CrossOriginStoragePersistence.h",
    "CrossOriginStoragePublicHashList.h",
    "CrossOriginStorageRateLimiter.h",
    "CrossOriginStorageRegistry.h",
    "CrossOriginStorageRequestHandler.h",
    "CrossOriginStorageService.h",
    "CrossOriginStorageSinkAlgorithms.h",
    "CrossOriginStorageUtils.h",
    "CrossOriginStorageWritableFileStream.h",
]

UNIFIED_SOURCES += [
    "CrossOriginStorageManager.cpp",
    "CrossOriginStorageParent.cpp",
    "CrossOriginStoragePersistence.cpp",
    "CrossOriginStoragePublicHashList.cpp",
    "CrossOriginStorageRateLimiter.cpp",
    "CrossOriginStorageRegistry.cpp",
    "CrossOriginStorageRequestHandler.cpp",
    "CrossOriginStorageService.cpp",
    "CrossOriginStorageSinkAlgorithms.cpp",
    "CrossOriginStorageUtils.cpp",
    "CrossOriginStorageWritableFileStream.cpp",
]

IPDL_SOURCES += [
    "PCrossOriginStorage.ipdl",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

XPIDL_MODULE = "crossoriginstorage"

XPIDL_SOURCES += [
    "nsICrossOriginStorageService.idl",
]

# The real Public Hash List snapshot CrossOriginStoragePublicHashList loads
# at runtime (see that class's own header comment and
# generate_public_hash_list.py) -- shipped as a plain data file alongside
# the GRE rather than compiled in, since embedding ~9 MiB of high-entropy
# (so, uncompressible) digest data as a C++ array literal would bloat this
# translation unit and compile time for no benefit over a single lazy file
# read.
FINAL_TARGET_FILES.crossoriginstorage += [
    "data/public-hash-list.bin",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "/dom/fs/include",
    "/dom/streams",
    "/security/manager/ssl",
    "/xpcom/build",
]

TEST_DIRS += [
    "gtest",
]
